{
  "name": "powerbi-visuals-utils-onobjectutils",
  "version": "7.0.0",
  "description": "Provides helper utilities to enable and manage sub-selection outlines in Power BI custom visuals, making it easier to define, render, and interact with subselectable elements",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microsoft/powerbi-visuals-utils-onobjectutils.git"
  },
  "keywords": [
    "powerbi-visuals-utils"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Microsoft",
  "license": "MIT",
  "homepage": "https://github.com/microsoft/powerbi-visuals-utils-onobjectutils#readme",
  "bugs": {
    "url": "https://github.com/microsoft/powerbi-visuals-utils-onobjectutils/issues"
  },
  "dependencies": {
    "d3-selection": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^26.6.3",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "playwright": "^1.62.1",
    "powerbi-visuals-api": "^5.11.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.2"
  }
}
